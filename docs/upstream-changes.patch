+# -- Generic API call (dev/explore) ------------------------------------------
+
+def _h_api_call(p):
+    """Call one FL scripting-module function: {module, fn, args?} -> {result}.
+    Only FL API modules are reachable (no builtins/eval). Results that aren't
+    JSON-safe are returned as repr strings. Use 'batch': [[fn, args], ...] to
+    make several calls on the same module in one round trip."""
+    mods = {"plugins": plugins, "channels": channels, "mixer": mixer, "patterns": patterns,
+            "playlist": playlist, "transport": transport, "ui": ui, "general": general,
+            "device": device, "arrangement": arrangement, "midi": midi}
+    mod = mods.get(p.get("module", ""))
+    if mod is None:
+        return {"ok": False, "error": "unknown module %r" % p.get("module")}
+
+    def one(fn, args):
+        f = getattr(mod, fn, None)
+        if f is None:
+            return {"fn": fn, "error": "no such function"}
+        try:
+            r = f(*args) if callable(f) else f
+            try:
+                json.dumps(r)
+            except (TypeError, ValueError):
+                r = repr(r)
+            return {"fn": fn, "result": r}
+        except Exception as e:
+            return {"fn": fn, "error": "%s: %s" % (type(e).__name__, e)}
+
+    if "batch" in p:
+        return {"ok": True, "results": [one(fn, args) for fn, args in p["batch"]]}
+    return dict(ok=True, **one(p["fn"], p.get("args", [])))
+
+
